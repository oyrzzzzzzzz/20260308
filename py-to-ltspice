# ==========================================
def spice_to_float(val_str):
    if isinstance(val_str, (int, float)):
        return float(val_str)
    val_str = str(val_str).strip().lower()
    val_str = val_str.replace('µ', 'u').replace('μ', 'u')

    multipliers = {
        'f': 1e-15, 'p': 1e-12, 'n': 1e-9, 'u': 1e-6,
        'm': 1e-3,  'k': 1e3,  'meg': 1e6, 'g': 1e9
    }
    m = re.match(r"^([-+]?[0-9]*\.?[0-9]+(?:[eE][-+]?[0-9]+)?)([a-zA-Z]*)$", val_str)
    if not m:
        return float('nan')

    num = float(m.group(1))
    suf = m.group(2)

    # 兼容 ns/us/ms 写法
    if suf.endswith('s') and suf not in multipliers:
        suf = suf[:-1]

    return num * multipliers.get(suf, 1.0)


def mean_by_time(t_arr, y_arr, side='start', dur_s=50e-9):
    if len(t_arr) == 0:
        return float('nan')
    t_arr = np.asarray(t_arr)
    y_arr = np.asarray(y_arr)

    if side == 'start':
        m = t_arr <= (t_arr[0] + dur_s)
        if not np.any(m):
            return float(np.mean(y_arr[:max(1, min(10, len(y_arr)))]))
        return float(np.mean(y_arr[m]))
    else:
        m = t_arr >= (t_arr[-1] - dur_s)
        if not np.any(m):
            return float(np.mean(y_arr[-max(1, min(10, len(y_arr))):]))
        return float(np.mean(y_arr[m]))


def swing_levels(t_arr, y_arr, dur_s=50e-9):
    a = mean_by_time(t_arr, y_arr, 'start', dur_s)
    b = mean_by_time(t_arr, y_arr, 'end', dur_s)
    return (min(a, b), max(a, b))


def calc_max_slope(time_arr, wave_arr, window_s=10e-9):
    time_arr = np.asarray(time_arr)
    wave_arr = np.asarray(wave_arr)
    if len(time_arr) < 2:
        return float('nan')
    dt_avg = np.mean(np.diff(time_arr))
    if dt_avg <= 0:
        return float('nan')

    pts = max(1, int(window_s / dt_avg))
    if pts >= len(wave_arr):
        return abs(wave_arr[-1] - wave_arr[0]) / (time_arr[-1] - time_arr[0]) * 1e-9

    slopes = np.abs(wave_arr[pts:] - wave_arr[:-pts]) / (time_arr[pts:] - time_arr[:-pts])
    return float(np.max(slopes) * 1e-9)  # /s -> /ns


