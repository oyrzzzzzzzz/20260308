# ⚙️ 从 .net 读参数（最稳）
# ==========================================
def extract_netlist_params(net_file_path):
    extracted = {k: float('nan') for k in USER_PARAM_MAP.keys()}
    if not os.path.exists(net_file_path):
        print(f"⚠️ 找不到网表文件: {net_file_path}")
        return extracted

    with open(net_file_path, 'r', encoding='utf-8', errors='ignore') as f:
        content = f.read()

    value_pat = r"(\{[^}]*\}|[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?(?:[a-zA-Zµμ]+)?)"

    for internal_name, spice_name in USER_PARAM_MAP.items():
        m = re.findall(
            rf"(?im)^\s*\.param\b.*\b{re.escape(spice_name)}\b\s*(?:=\s*|\s+){value_pat}",
            content
        )
        if m:
            extracted[internal_name] = spice_to_float(m[-1])

    print(f"✅ 从 .net 提取参数: Ton={extracted.get('Ton')}, Tperiod={extracted.get('Tperiod')}, "
          f"Tdelay={extracted.get('Tdelay')}, Ncycles={extracted.get('Ncycles')}")
    return extracted


# ==========================================
# ⚙️ ASC 参数修改器（修复 \n 吞噬）
# ==========================================
def update_asc_params(template_path, target_path, param_updates):
    with open(template_path, 'r', encoding='cp1252', errors='ignore') as f:
        lines = f.readlines()

    value_pattern = r"(\{[^}]*\}|[^\\\s]+)"  # 不跨过 \

    new_lines = []
    for line in lines:
        if line.startswith('TEXT') and '.param' in line.lower():
            for p_name, p_val in param_updates.items():
                pat = re.compile(
                    rf"(\b{re.escape(p_name)}\b\s*(?:=\s*|\s+)){value_pattern}",
                    re.IGNORECASE
                )
                if pat.search(line):
                    old_line = line.rstrip("\n")
                    new_val = str(p_val).strip()
                    line = pat.sub(lambda m: m.group(1) + new_val, line, count=1)

                    print(f"      [参数微创手术] {p_name}:")
                    print(f"         修改前 -> {old_line}")
                    print(f"         修改后 -> {line.rstrip()}")

        new_lines.append(line)

    with open(target_path, 'w', encoding='cp1252') as f:
        f.writelines(new_lines)


