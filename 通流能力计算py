def load_data_from_xml(xml_path):
    tree = ET.parse(xml_path)
    root = tree.getroot()
    _strip_ns(root)
    data = {"IS_MOSFET": False, "HAS_THERMAL": False, "R_TH": None, "FOSTER_R": np.array([], dtype=np.float64), "FOSTER_TAU": np.array([], dtype=np.float64)}

    def parse_energy_table(energy_node, target_scale_base=0.001):
        xml_scale = float(energy_node.get("scale", 1.0))
        factor = xml_scale / target_scale_base
        temps = []
        for t_node in energy_node.findall(".//Temperature"):
            v_nodes = t_node.findall("Voltage")
            rows = []
            if v_nodes:
                for v_node in v_nodes: rows.append(_txt_to_arr(v_node.text) * factor)
            elif t_node.text and t_node.text.strip():
                rows.append(_txt_to_arr(t_node.text) * factor)
            temps.append(np.array(rows, dtype=np.float64))
        return np.array(temps, dtype=np.float64) if temps else None

    for semi in root.findall(".//SemiconductorData"):
        s_type = (semi.get("type") or "")
        target_type = None
        if "MOSFET" in s_type: target_type = "IGBT"; data["IS_MOSFET"] = True
        elif "IGBT" in s_type: target_type = "IGBT"
        elif "Diode" in s_type: target_type = "Diode"
        if target_type is None: continue

        ton_node = semi.find("TurnOnLoss") or semi.find("TurnOn")
        toff_node = semi.find("TurnOffLoss") or semi.find("TurnOff")
        cond_node = semi.find("ConductionLoss")

        if ton_node is not None:
            v_axis = ton_node.find("VoltageAxis"); t_axis = ton_node.find("TemperatureAxis"); i_axis = ton_node.find("CurrentAxis"); e_node = ton_node.find("Energy")
            if v_axis is not None: data["V_AXIS_SW"] = np.abs(_txt_to_arr(v_axis.text))
            if t_axis is not None: data["T_AXIS_SW"] = _txt_to_arr(t_axis.text)
            if target_type == "IGBT" and i_axis is not None: data["IGBT_I_SW"] = _txt_to_arr(i_axis.text)
            if e_node is not None:
                arr = parse_energy_table(e_node, target_scale_base=0.001)
                if arr is not None: data["IGBT_E_ON"] = arr

        if toff_node is not None:
            v_axis = toff_node.find("VoltageAxis")
            if ("V_AXIS_SW" not in data) and (v_axis is not None): data["V_AXIS_SW"] = np.abs(_txt_to_arr(v_axis.text))
            t_axis = toff_node.find("TemperatureAxis")
            if ("T_AXIS_SW" not in data) and (t_axis is not None): data["T_AXIS_SW"] = _txt_to_arr(t_axis.text)
            i_axis_off = toff_node.find("CurrentAxis")
            i_off = _txt_to_arr(i_axis_off.text) if i_axis_off is not None else np.array([], dtype=np.float64)
            e_node = toff_node.find("Energy")
            if e_node is not None:
                arr = parse_energy_table(e_node, target_scale_base=0.001)
                if arr is not None:
                    if target_type == "IGBT":
                        if "IGBT_I_SW" not in data and i_off.size: data["IGBT_I_SW"] = i_off
                        data["IGBT_E_OFF"] = arr
                    else:
                        data["DIODE_I_SW"] = i_off; data["DIODE_E_RR"] = arr

        if cond_node is not None:
            t_axis = cond_node.find("TemperatureAxis")
            if t_axis is not None: data["T_AXIS_COND"] = _txt_to_arr(t_axis.text)
            i_axis = cond_node.find("CurrentAxis")
            raw_i = _txt_to_arr(i_axis.text) if i_axis is not None else np.array([], dtype=np.float64)
            v_drop_node = cond_node.find("VoltageDrop")
            parent = v_drop_node if v_drop_node is not None else cond_node
            scale = float(parent.get("scale", 1.0))
            rows = []
            for t_node in parent.findall("Temperature"): rows.append(_txt_to_arr(t_node.text) * scale)
            raw_v = np.array(rows, dtype=np.float64)
            if target_type == "IGBT":
                if data.get("IS_MOSFET", False) and np.any(raw_i < 0):
                    mask_pos = raw_i >= 0; data["IGBT_I_COND"] = raw_i[mask_pos]; data["IGBT_V_DROP"] = raw_v[:, mask_pos]
                    mask_neg = raw_i <= 0; di = np.abs(raw_i[mask_neg]); dv = np.abs(raw_v[:, mask_neg])
                    data["DIODE_I_COND"] = di[::-1]; data["DIODE_V_DROP"] = dv[:, ::-1]
                else:
                    data["IGBT_I_COND"] = raw_i; data["IGBT_V_DROP"] = raw_v
                    if data.get("IS_MOSFET", False):
                        if ("DIODE_I_COND" not in data) and ("DIODE_V_DROP" not in data):
                            di, dv = _build_diode_from_mos_linear_extrap_first2(raw_i, raw_v)
                            if di is not None: data["DIODE_I_COND"] = di; data["DIODE_V_DROP"] = dv
            else:
                data["DIODE_I_COND"] = raw_i; data["DIODE_V_DROP"] = raw_v

    thermal = root.find(".//ThermalModel")
    if thermal is not None:
        branch = thermal.find(".//Branch")
        if branch is not None:
            btype = (branch.get("type") or "").lower()
            if ("foster" in btype) or (btype == ""):
                r_list, tau_list = [], []
                for el in branch.findall(".//RTauElement"):
                    try: r_list.append(float(el.get("R"))); tau_list.append(float(el.get("Tau")))
                    except: pass
                if r_list:
                    data["FOSTER_R"] = np.array(r_list, dtype=np.float64); data["FOSTER_TAU"] = np.array(tau_list, dtype=np.float64)
                    data["R_TH"] = float(np.sum(data["FOSTER_R"])); data["HAS_THERMAL"] = True
    return data


