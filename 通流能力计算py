def run_single_point_logic(cfg, logger):
    logger("="*60 + "\n单点计算 (Foster瞬态热 + 查表线性外推 + Tj_mean闭环)\n" + "="*60)
    lut = _prepare_luts_from_xml(cfg); I_in, t0 = float(cfg["INPUT_I_RMS"]), time.time()
    res, warm = worker_single_point(I_in, cfg, lut, warm=None, steady_mode=False)
    
    p_cond = res[3] + res[4]
    p_sw = res[0] + res[1] + res[2]
    p_loss = p_cond + p_sw
    eff = (max(0, abs(res[5])-p_loss*6.0)/abs(res[5])*100.0) if abs(res[5])>1.0 else 0.0
    rth_i = cfg.get("RTH_IGBT", 0.0)
    rth_d = cfg.get("RTH_DIODE", 0.0)
    
    logger(f"[Result] I_in={I_in:.3f}A, time={time.time()-t0:.2f}s\n"
           f"  Sim I_rms={res[6]:.3f}A, V_line={res[7]:.3f}V, Pdc={res[5]:.3f}W, Eff={eff:.2f}%\n"
           f"  Switch: Tj_mean={res[10]:.3f}C, Tj_max={res[8]:.3f}C\n"
           f"  Loss Detail:\n"
           f"    P_cond = {p_cond:.3f} W\n"
           f"    P_sw   = {p_sw:.3f} W  (On={res[0]:.3f}, Off={res[1]:.3f}, Rr={res[2]:.3f})\n"
           f"    P_total= {p_loss:.3f} W\n"
           f"    Ratio (Cond/Sw) = {(p_cond/p_sw if p_sw > 1e-6 else 0.0):.3f}\n"
           f"    Rth    = IGBT {rth_i:.4f}, Diode {rth_d:.4f} K/W\n"
           + "="*60)

def run_current_rating_logic(cfg, logger):
    logger("="*60 + "\n通流能力 (支持多点计算)\n" + "="*60)
    lut = _prepare_luts_from_xml(cfg); t0 = time.time()
    tasks = cfg.get("RATING_TASKS", [{"T": float(cfg["RATING_TJ_TARGET"]), "L": float(cfg["RATING_I_LOW"]), "H": float(cfg["RATING_I_HIGH"])}])
    
    for i, t in enumerate(tasks):
        T_target, I_L, I_H = float(t["T"]), float(t["L"]), float(t["H"])
        logger(f"\n>>> 任务 {i+1}/{len(tasks)}: 目标 Tj={T_target}C, 范围 [{I_L}, {I_H}] A")
        I_star, res, warm = solve_current_for_tj_mean(cfg, lut, I_L, I_H, T_target, float(cfg["RATING_TOL_T"]), float(cfg["RATING_TOL_I"]), int(cfg["RATING_MAX_IT"]), logger=logger)
        
        p_cond = res[3] + res[4]
        p_sw = res[0] + res[1] + res[2]
        p_loss = p_cond + p_sw
        rth_i = warm.get("Rth", {}).get("Rth_I", 0.0)
        
        logger(f"[Rating Result #{i+1}] I_rms = {I_star:.2f} A @ Tj_mean={res[10]:.2f}C (Target {T_target}C)\n"
               f"  Switch: Tj_max={res[8]:.2f}C, Diode: Tj_max={res[9]:.2f}C, Tj_mean={res[11]:.2f}C\n"
               f"  Loss: {p_loss:.2f}W (Cond={p_cond:.2f}, Sw={p_sw:.2f} -> On={res[0]:.2f}, Off={res[1]:.2f}, Rr={res[2]:.2f})\n"
               f"  Rth_IGBT: {rth_i:.4f} K/W\n" + "-"*30)
    logger(f"\n所有任务完成, 总耗时: {time.time()-t0:.2f}s\n" + "="*60)


