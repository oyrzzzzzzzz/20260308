def solve_current_for_tj_mean(cfg, lut_bundle, I_low, I_high, T_target, tol_T=0.2, tol_I=0.1, max_iter=25, logger=None):
    def log(s): (logger(s) if logger else None)
    method = cfg.get("RATING_METHOD", "Bisection")
    switch_win = float(cfg.get("RATING_SWITCH_WIN", 10.0))
    warm = None; best_I, last_res = 0.0, None
    if method == "Secant":
        log(f">>> 启动割线法 (Secant)... 目标: {T_target}C")
        x0, x1 = float(I_low), float(I_high)
        res0, warm = worker_single_point(x0, cfg, lut_bundle, warm, steady_mode=True)
        f0 = res0[10] - T_target
        res1, warm = worker_single_point(x1, cfg, lut_bundle, warm, steady_mode=True)
        f1 = res1[10] - T_target
        best_I, last_res = x1, res1
        for k in range(max_iter):
            if abs(f1 - f0) < 1e-6: break
            x_next = max(0.0, min(x1 - f1 * (x1 - x0) / (f1 - f0), 2000.0))
            is_steady = abs(x_next - x1) > switch_win
            res_next, warm = worker_single_point(x_next, cfg, lut_bundle, warm, steady_mode=is_steady)
            f_next = res_next[10] - T_target
            log(f"[Secant {k+1:02d}] I={x_next:.2f}A, Tj_err={f_next:+.3f}C, Mode={'Steady' if is_steady else 'Transient'}")
            best_I, last_res = x_next, res_next
            if abs(f_next) <= tol_T or abs(x_next - x1) <= tol_I: break
            x0, f0, x1, f1 = x1, f1, x_next, f_next
    else:
        log(f">>> 启动二分法 (Bisection)... 目标: {T_target}C")
        lo, hi = I_low, I_high
        for k in range(max_iter):
            mid = 0.5 * (lo + hi)
            is_steady = (hi - lo) > switch_win
            resM, warm = worker_single_point(mid, cfg, lut_bundle, warm, steady_mode=is_steady)
            tjM = resM[10]; err = tjM - T_target
            log(f"[Bisection {k+1:02d}] I={mid:.2f}A, Tj_err={err:+.3f}C, Mode={'Steady' if is_steady else 'Transient'}")
            best_I, last_res = mid, resM
            if abs(err) <= tol_T or (hi - lo) <= tol_I: break
            if tjM < T_target: lo = mid
            else: hi = mid
    log(">>> 切换到最终精细瞬态计算以锁定精度...")
    # ✅ 核心精度修复：最后一轮增加迭代时长确保热平衡
    cfg_final = cfg.copy(); cfg_final["HI_ITER"] = max(cfg_final.get("HI_ITER", 50), 100) 
    final_res, warm_final = worker_single_point(best_I, cfg_final, lut_bundle, warm, steady_mode=False)
    return (best_I, final_res, warm_final)


