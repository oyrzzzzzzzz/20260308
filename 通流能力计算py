@njit(cache=False, fastmath=False)
def _idx_for_extrap(axis, x):
    n = len(axis)
    if n < 2: return 0
    i = np.searchsorted(axis, x) - 1
    if i < 0: i = 0
    if i > n - 2: i = n - 2
    return i

@njit(cache=False, fastmath=False)
def lookup_2d_extrap(x, y, x_axis, y_axis, table):
    ix = _idx_for_extrap(x_axis, x); iy = _idx_for_extrap(y_axis, y)
    x1, x2 = x_axis[ix], x_axis[ix+1]; y1, y2 = y_axis[iy], y_axis[iy+1]
    Q11, Q21 = table[iy, ix], table[iy, ix+1]; Q12, Q22 = table[iy+1, ix], table[iy+1, ix+1]
    dx = x2 - x1; fx = 0.0 if dx == 0.0 else (x - x1) / dx
    R1 = Q11 * (1.0 - fx) + Q21 * fx; R2 = Q12 * (1.0 - fx) + Q22 * fx
    dy = y2 - y1; fy = 0.0 if dy == 0.0 else (y - y1) / dy
    return R1 * (1.0 - fy) + R2 * fy

@njit(cache=False, fastmath=False)
def lookup_3d_extrap(i, t, v, i_axis, t_axis, v_axis, table3d):
    if len(v_axis) < 2: iv0 = 0; fv = 0.0
    else:
        iv0 = _idx_for_extrap(v_axis, v); v1, v2 = v_axis[iv0], v_axis[iv0+1]
        dv = v2 - v1; fv = 0.0 if dv == 0.0 else (v - v1) / dv
    if len(t_axis) < 2: it0 = 0; ft = 0.0
    else:
        it0 = _idx_for_extrap(t_axis, t); t1, t2 = t_axis[it0], t_axis[it0+1]
        dt = t2 - t1; ft = 0.0 if dt == 0.0 else (t - t1) / dt
    if len(i_axis) < 2: ii0 = 0; fi = 0.0
    else:
        ii0 = _idx_for_extrap(i_axis, i); i1, i2 = i_axis[ii0], i_axis[ii0+1]
        di = i2 - i1; fi = 0.0 if di == 0.0 else (i - i1) / di
    v_tl_vl_il, v_tl_vl_ih = table3d[it0, iv0, ii0], table3d[it0, iv0, ii0+1]
    v_tl_vh_il, v_tl_vh_ih = table3d[it0, iv0+1, ii0], table3d[it0, iv0+1, ii0+1]
    v_th_vl_il, v_th_vl_ih = table3d[it0+1, iv0, ii0], table3d[it0+1, iv0, ii0+1]
    v_th_vh_il, v_th_vh_ih = table3d[it0+1, iv0+1, ii0], table3d[it0+1, iv0+1, ii0+1]
    val_tl_vl = v_tl_vl_il * (1-fi) + v_tl_vl_ih * fi; val_tl_vh = v_tl_vh_il * (1-fi) + v_tl_vh_ih * fi
    val_th_vl = v_th_vl_il * (1-fi) + v_th_vl_ih * fi; val_th_vh = v_th_vh_il * (1-fi) + v_th_vh_ih * fi
    val_tl = val_tl_vl * (1-fv) + val_tl_vh * fv; val_th = val_th_vl * (1-fv) + val_th_vh * fv
    return val_tl * (1-ft) + val_th * ft

MIN_I_SW = 1e-5

@njit(cache=False, fastmath=False)
def E_on(vdc, i_inst, T, i_axis, t_axis, v_axis, tab):
    ia = abs(i_inst)
    if ia < MIN_I_SW: return 0.0
    return lookup_3d_extrap(ia, T, vdc, i_axis, t_axis, v_axis, tab) * 1e-3

@njit(cache=False, fastmath=False)
def E_off(vdc, i_inst, T, i_axis, t_axis, v_axis, tab):
    ia = abs(i_inst)
    if ia < MIN_I_SW: return 0.0
    return lookup_3d_extrap(ia, T, vdc, i_axis, t_axis, v_axis, tab) * 1e-3

@njit(cache=False, fastmath=False)
def E_rr(vdc, i_inst, T, i_axis, t_axis, v_axis, tab):
    ia = abs(i_inst)
    if ia < MIN_I_SW: return 0.0
    return lookup_3d_extrap(ia, T, vdc, i_axis, t_axis, v_axis, tab) * 1e-3

@njit(cache=False, fastmath=False)
def V_igbt(i_inst, T, i_axis, t_axis, tab2d):
    ia = abs(i_inst)
    if ia < 1e-9: return 0.0
    return lookup_2d_extrap(ia, T, i_axis, t_axis, tab2d)

@njit(cache=False, fastmath=False)
def V_diode(i_inst, T, i_axis, t_axis, tab2d):
    ia = abs(i_inst)
    if ia < 1e-9: return 0.0
    return lookup_2d_extrap(ia, T, i_axis, t_axis, tab2d)

@njit(cache=False, fastmath=False)
def svpwm_cmp(Valpha, Vbeta, Vdc, Ts):
    PI = 3.141592653589793
    Vm = math.sqrt(Valpha*Valpha + Vbeta*Vbeta); ang = math.atan2(Vbeta, Valpha)
    if ang < 0: ang += 2*PI
    sec = int(ang / (PI/3))
    if sec > 5: sec = 5
    th = ang - sec*(PI/3); K = Vm * Ts / (math.sqrt(3)/2) / (2*Vdc/3)
    if sec % 2 != 0: T1, T2 = K * math.sin(th), K * math.sin(PI/3 - th)
    else: T1, T2 = K * math.sin(PI/3 - th), K * math.sin(th)
    if T1 + T2 > Ts: r = Ts / (T1 + T2); T1 *= r; T2 *= r
    T0 = Ts - T1 - T2; cmpa=cmpb=cmpc=0.0
    if sec == 0: cmpa, cmpb, cmpc = T0/4, T0/4+T1/2, T0/4+T1/2+T2/2
    elif sec == 1: cmpb, cmpa, cmpc = T0/4, T0/4+T1/2, T0/4+T1/2+T2/2
    elif sec == 2: cmpb, cmpc, cmpa = T0/4, T0/4+T1/2, T0/4+T1/2+T2/2
    elif sec == 3: cmpc, cmpb, cmpa = T0/4, T0/4+T1/2, T0/4+T1/2+T2/2
    elif sec == 4: cmpc, cmpa, cmpb = T0/4, T0/4+T1/2, T0/4+T1/2+T2/2
    else: cmpa, cmpc, cmpb = T0/4, T0/4+T1/2, T0/4+T1/2+T2/2
    return cmpa, cmpb, cmpc

@njit(cache=False, fastmath=False)
def simulation_kernel_stateful_transient(
        t_start, ia0, ib0, ic0,
        run_cycles, dt, T_fund, w, V_phase_pk, Vdc, Ts, fsw,
        E_mag, E_ang, R_load, L_load,
        T_lookup_igbt, T_lookup_diode,
        T_coolant,
        p_avg_init_igbt, p_avg_init_diode,
        ANALYZE_LAST_N_CYCLES, target_device_idx,
        calc_rms_flag,
        V_AXIS_SW, T_AXIS_SW, T_AXIS_COND,
        I_SW_MOS, TAB_EON, TAB_EOFF, I_COND_MOS, TAB_VDROP,
        I_SW_DIODE, TAB_ERR, I_COND_DIODE, TAB_VDIODE,
        F_R_IGBT, F_TAU_IGBT, F_R_DIODE, F_TAU_DIODE,
        is_mosfet_flag
):
    PI = 3.141592653589793; steps = int(run_cycles * T_fund / dt)
    nI = len(F_R_IGBT); thI, aI, gI = np.zeros(nI), np.zeros(nI), np.zeros(nI)
    for k in range(nI):
        tau = F_TAU_IGBT[k]; a = math.exp(-dt/tau) if tau > 1e-12 else 0.0
        aI[k], gI[k], thI[k] = a, F_R_IGBT[k]*(1.0-a), p_avg_init_igbt*F_R_IGBT[k]
    nD = len(F_R_DIODE); thD, aD, gD = np.zeros(nD), np.zeros(nD), np.zeros(nD)
    for k in range(nD):
        tau = F_TAU_DIODE[k]; a = math.exp(-dt/tau) if tau > 1e-12 else 0.0
        aD[k], gD[k], thD[k] = a, F_R_DIODE[k]*(1.0-a), p_avg_init_diode*F_R_DIODE[k]
    acc_on=acc_off=acc_rr=acc_ci=acc_cd=acc_in=acc_i2=acc_v2=0.0; n_samp=0
    tjI_max, tjD_max, tjI_sum, tjD_sum = -1e9, -1e9, 0.0, 0.0; tj_cnt = 0
    ia, ib, ic = ia0, ib0, ic0; state_a_prev = 0; pwm_idx = -1; da=db=dc=0.0; Valpha=Vbeta=0.0
    run_dur = run_cycles * T_fund; stat_start = max(0.0, run_dur - (ANALYZE_LAST_N_CYCLES * T_fund))
    pwm_phase_offset = w * (Ts/2.0)
    for k in range(steps):
        t_rel = k * dt; t_abs = t_start + t_rel; now_idx = int(t_abs * fsw)
        if now_idx > pwm_idx:
            th = w*t_abs + pwm_phase_offset; Valpha, Vbeta = V_phase_pk*math.cos(th), V_phase_pk*math.sin(th)
            ca, cb, cc = svpwm_cmp(Valpha, Vbeta, Vdc, Ts)
            da, db, dc = 1.0-2.0*ca/Ts, 1.0-2.0*cb/Ts, 1.0-2.0*cc/Ts; pwm_idx = now_idx
        t_mod = t_abs % Ts; carrier = (t_mod/(Ts/2.0)) if (t_mod < Ts/2.0) else (2.0 - t_mod/(Ts/2.0))
        sa, sb, sc = (1 if da >= carrier else 0), (1 if db >= carrier else 0), (1 if dc >= carrier else 0)
        pI, pD = 0.0, 0.0
        if target_device_idx == 0:
            if sa != state_a_prev:
                if sa == 1:
                    if ia < 0:
                        e = E_off(Vdc, ia, T_lookup_igbt, I_SW_MOS, T_AXIS_SW, V_AXIS_SW, TAB_EOFF)
                        if t_rel >= stat_start: acc_off += e
                        pI += e/dt
                    else:
                        e = E_rr(Vdc, ia, T_lookup_diode, I_SW_DIODE, T_AXIS_SW, V_AXIS_SW, TAB_ERR)
                        if t_rel >= stat_start: acc_rr += e
                        pD += e/dt
                else:
                    if ia < 0:
                        e = E_on(Vdc, ia, T_lookup_igbt, I_SW_MOS, T_AXIS_SW, V_AXIS_SW, TAB_EON)
                        if t_rel >= stat_start: acc_on += e
                        pI += e/dt
            if sa == 0:
                if ia < 0:
                    vd = V_igbt(ia, T_lookup_igbt, I_COND_MOS, T_AXIS_COND, TAB_VDROP)
                    pc = vd*abs(ia)
                    if t_rel >= stat_start: acc_ci += pc*dt
                    pI += pc
                else:
                    vf = V_diode(ia, T_lookup_diode, I_COND_DIODE, T_AXIS_COND, TAB_VDIODE)
                    pc = vf*abs(ia)
                    if t_rel >= stat_start: acc_cd += pc*dt
                    pD += pc
        else:
            if sa != state_a_prev:
                if sa == 0:
                    if ia > 0:
                        e = E_off(Vdc, ia, T_lookup_igbt, I_SW_MOS, T_AXIS_SW, V_AXIS_SW, TAB_EOFF)
                        if t_rel >= stat_start: acc_off += e
                        pI += e/dt
                    else:
                        e = E_rr(Vdc, ia, T_lookup_diode, I_SW_DIODE, T_AXIS_SW, V_AXIS_SW, TAB_ERR)
                        if t_rel >= stat_start: acc_rr += e
                        pD += e/dt
                else:
                    if ia > 0:
                        e = E_on(Vdc, ia, T_lookup_igbt, I_SW_MOS, T_AXIS_SW, V_AXIS_SW, TAB_EON)
                        if t_rel >= stat_start: acc_on += e
                        pI += e/dt
            if sa == 1:
                if ia > 0:
                    vd = V_igbt(ia, T_lookup_igbt, I_COND_MOS, T_AXIS_COND, TAB_VDROP)
                    pc = vd*abs(ia)
                    if t_rel >= stat_start: acc_ci += pc*dt
                    pI += pc
                else:
                    vf = V_diode(ia, T_lookup_diode, I_COND_DIODE, T_AXIS_COND, TAB_VDIODE)
                    pc = vf*abs(ia)
                    if t_rel >= stat_start: acc_cd += pc*dt
                    pD += pc
        if is_mosfet_flag > 0:
            pT, rise = pI + pD, 0.0
            for j in range(nI): thI[j] = thI[j]*aI[j] + pT*gI[j]; rise += thI[j]
            tjI = T_coolant + rise; tjD = tjI
        else:
            riseI, riseD = 0.0, 0.0
            for j in range(nI): thI[j] = thI[j]*aI[j] + pI*gI[j]; riseI += thI[j]
            for j in range(nD): thD[j] = thD[j]*aD[j] + pD*gD[j]; riseD += thD[j]
            tjI, tjD = T_coolant+riseI, T_coolant+riseD
        if t_rel >= stat_start:
            if tjI > tjI_max: tjI_max = tjI
            if tjD > tjD_max: tjD_max = tjD
            tjI_sum, tjD_sum, tj_cnt = tjI_sum+tjI, tjD_sum+tjD, tj_cnt+1
            idc = (ia if sa==1 else 0.0) + (ib if sb==1 else 0.0) + (ic if sc==1 else 0.0)
            acc_in += (Vdc * idc) * dt
            if calc_rms_flag > 0:
                acc_i2 += (ia*ia + ib*ib + ic*ic)
                vref_a, vref_b, vref_c = Valpha, -0.5*Valpha+0.866*Vbeta, -0.5*Valpha-0.866*Vbeta
                acc_v2 += ((vref_a-vref_b)**2 + (vref_b-vref_c)**2 + (vref_c-vref_a)**2); n_samp += 1
        state_a_prev = sa; va, vb, vc = (Vdc if sa else 0.0), (Vdc if sb else 0.0), (Vdc if sc else 0.0)
        vn = (va+vb+vc)/3.0; th_e = w*t_abs + E_ang; ea, eb, ec = E_mag*math.cos(th_e), E_mag*math.cos(th_e-2*PI/3), E_mag*math.cos(th_e+2*PI/3)
        ia += (va-vn-R_load*ia-ea)/L_load*dt; ib += (vb-vn-R_load*ib-eb)/L_load*dt; ic += (vc-vn-R_load*ic-ec)/L_load*dt
    tjI_mean, tjD_mean = (tjI_sum/tj_cnt if tj_cnt>0 else T_coolant), (tjD_sum/tj_cnt if tj_cnt>0 else T_coolant)
    return (acc_on, acc_off, acc_rr, acc_ci, acc_cd, acc_in, acc_i2, acc_v2, n_samp, t_abs, ia, ib, ic, tjI_max, tjD_max, tjI_mean, tjD_mean)


