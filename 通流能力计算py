            try: run_current_rating_logic(self._cfg(), self._log)
            except Exception as e: self._log(f"!!! ERROR: {e}\n{traceback.format_exc()}")
            finally: self.btn_single.config(state="normal"); self.btn_rating.config(state="normal")
        threading.Thread(target=_target, daemon=True).start()

    def _run_batch_dialog(self):
        # Pass a pure dict config, not one containing Tk vars if possible, 
        # but _cfg() already does that.
        # Wait, in __init__ we did: self.base_cfg["VAR_CPU"] = var_cpu
        # var_cpu is a tk.IntVar! That's the problem.
        
        # We need to separate the pure data config from the GUI control variables.
        clean_cfg = self._cfg()
        BatchDialog(self.root, clean_cfg, self.var_cpu_cores)

if __name__ == "__main__":
    multiprocessing.freeze_support(); root = tk.Tk(); App(root); root.mainloop()
