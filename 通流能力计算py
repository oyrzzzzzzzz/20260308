def _assert_xml_ok(name, d):
    if not d.get("HAS_THERMAL", False): raise RuntimeError(f"{name} XML 没有 Foster ThermalModel。")
    if d.get("R_TH", None) is None or d["R_TH"] <= 1e-9: raise RuntimeError(f"{name} XML 的 Rth 无效。")
    if d.get("FOSTER_R", np.array([])).size < 1: raise RuntimeError(f"{name} XML Foster_R 为空。")

def _prepare_luts_from_xml(cfg):
    xml_igbt, xml_diode = os.path.join(cfg["DIR_XML"], cfg["FILE_XML_IGBT"]), os.path.join(cfg["DIR_XML"], cfg["FILE_XML_DIODE"])
    vals_igbt = load_data_from_xml(xml_igbt); is_mos = bool(vals_igbt.get("IS_MOSFET", False)); _assert_xml_ok("IGBT/MOS", vals_igbt)
    V_AXIS_SW, T_AXIS_SW, T_AXIS_COND = vals_igbt.get("V_AXIS_SW", np.array([])), vals_igbt.get("T_AXIS_SW", np.array([])), vals_igbt.get("T_AXIS_COND", np.array([]))
    I_SW_MOS, TAB_EON, TAB_EOFF = vals_igbt.get("IGBT_I_SW", np.array([])), vals_igbt.get("IGBT_E_ON", None), vals_igbt.get("IGBT_E_OFF", None)
    I_COND_MOS, TAB_VDROP = vals_igbt.get("IGBT_I_COND", np.array([])), vals_igbt.get("IGBT_V_DROP", None)
    F_R_IGBT, F_TAU_IGBT = vals_igbt["FOSTER_R"], vals_igbt["FOSTER_TAU"]
    if TAB_EON is not None: TAB_EON = _align_3d_voltage(TAB_EON, vals_igbt.get("V_AXIS_SW", V_AXIS_SW), V_AXIS_SW)
    if TAB_EOFF is not None: TAB_EOFF = _align_3d_voltage(TAB_EOFF, vals_igbt.get("V_AXIS_SW", V_AXIS_SW), V_AXIS_SW)
    if is_mos:
        if ("DIODE_I_COND" not in vals_igbt) or ("DIODE_V_DROP" not in vals_igbt): raise RuntimeError("MOSFET 模式下外推失败。")
        I_COND_DIODE, TAB_VDIODE = vals_igbt["DIODE_I_COND"], vals_igbt["DIODE_V_DROP"]
        I_SW_DIODE, TAB_ERR, F_R_DIODE, F_TAU_DIODE, rth_diode = I_SW_MOS, (np.zeros_like(TAB_EON) if TAB_EON is not None else None), F_R_IGBT, F_TAU_IGBT, vals_igbt["R_TH"]
    else:
        vals_diode = load_data_from_xml(xml_diode); _assert_xml_ok("Diode", vals_diode)
        I_SW_DIODE, TAB_ERR = vals_diode.get("DIODE_I_SW", np.array([])), vals_diode.get("DIODE_E_RR", None)
        I_COND_DIODE, TAB_VDIODE = vals_diode.get("DIODE_I_COND", np.array([])), vals_diode.get("DIODE_V_DROP", None)
        F_R_DIODE, F_TAU_DIODE, rth_diode = vals_diode["FOSTER_R"], vals_diode["FOSTER_TAU"], vals_diode["R_TH"]
        if TAB_ERR is not None: TAB_ERR = _align_3d_voltage(TAB_ERR, vals_diode.get("V_AXIS_SW", V_AXIS_SW), V_AXIS_SW)
    cfg["RTH_IGBT"], cfg["RTH_DIODE"] = float(vals_igbt["R_TH"]), float(rth_diode)
    def _need(name, arr, minlen=2):
        if arr is None or (isinstance(arr, np.ndarray) and arr.size < minlen): raise RuntimeError(f"{name} 缺失或无效")
    _need("V_AXIS_SW", V_AXIS_SW, 1); _need("T_AXIS_SW", T_AXIS_SW, 1); _need("T_AXIS_COND", T_AXIS_COND, 1); _need("I_SW_MOS", I_SW_MOS, 2)
    _need("TAB_EON", TAB_EON, 1); _need("TAB_EOFF", TAB_EOFF, 1); _need("I_COND_MOS", I_COND_MOS, 2); _need("TAB_VDROP", TAB_VDROP, 1)
    _need("I_COND_DIODE", I_COND_DIODE, 2); _need("TAB_VDIODE", TAB_VDIODE, 1)
    return (V_AXIS_SW, T_AXIS_SW, T_AXIS_COND, I_SW_MOS, TAB_EON, TAB_EOFF, I_COND_MOS, TAB_VDROP, I_SW_DIODE, TAB_ERR, I_COND_DIODE, TAB_VDIODE, F_R_IGBT, F_TAU_IGBT, F_R_DIODE, F_TAU_DIODE, is_mos)

def worker_single_point(I_rms, cfg, lut_bundle, warm=None, steady_mode=False):
    (V_AXIS_SW, T_AXIS_SW, T_AXIS_COND, I_SW_MOS, TAB_EON, TAB_EOFF, I_COND_MOS, TAB_VDROP, I_SW_DIODE, TAB_ERR, I_COND_DIODE, TAB_VDIODE, F_R_IGBT, F_TAU_IGBT, F_R_DIODE, F_TAU_DIODE, is_mos) = lut_bundle
    Vdc, fsw, f_out, pf, m_in = float(cfg["VDC"]), float(cfg["FSW"]), float(cfg["INPUT_FREQ"]), float(cfg["INPUT_PF"]), float(cfg["INPUT_M"])
    w = 2 * np.pi * f_out if f_out > 1e-6 else 0.0
    if steady_mode:
        iters = int(cfg.get("RATING_STEADY_CYCLES", 5)); startup = iters; dt = float(cfg["HI_DT"]); stat = iters; max_inner = 5
    else:
        if f_out < cfg["FREQ_THRESHOLD"]: startup, iters, stat, dt = int(cfg["LO_STARTUP"]), int(cfg["LO_ITER"]), int(cfg["LO_STAT"]), float(cfg["LO_DT"])
        else: startup, iters, stat, dt = int(cfg["HI_STARTUP"]), int(cfg["HI_ITER"]), int(cfg["HI_STAT"]), float(cfg["HI_DT"])
        max_inner = 20
    T_fund = 1.0 / f_out if f_out > 1e-6 else 1.0; stat_dur = max(1e-9, stat * T_fund)
    v_phase_rms = (m_in * Vdc / math.sqrt(2.0)) / math.sqrt(3.0); v_ref_vec_rms = complex(v_phase_rms, 0.0)
    theta = math.acos(min(max(abs(pf), -1.0), 1.0))
    i_ref_vec_rms = complex(I_rms * math.cos(theta), -I_rms * math.sin(theta)); z_motor = complex(cfg["MOTOR_R"], w * cfg["MOTOR_L"])
    e_vec_rms = v_ref_vec_rms - i_ref_vec_rms * z_motor; E_ang, E_mag_pk = cmath.phase(e_vec_rms), abs(e_vec_rms) * math.sqrt(2.0)
    V_phase_pk_pwm = min(1.15, (m_in * Vdc / math.sqrt(2.0) * math.sqrt(2.0) / Vdc)) * Vdc / math.sqrt(3.0)
    Tlk_I, Tlk_D = (float(warm.get("Tlk_I", cfg["TC"])) if warm else float(cfg["TC"])), (float(warm.get("Tlk_D", cfg["TC"])) if warm else float(cfg["TC"]))
    pavg_I_prev, pavg_D_prev = (float(warm.get("pavg_I", 0.0)) if warm else 0.0), (float(warm.get("pavg_D", 0.0)) if warm else 0.0)
    t_curr, ia, ib, ic = 0.0, 0.0, 0.0, 0.0; is_mos_flag, final = (1 if is_mos else 0), None
    for it in range(max_inner):
        cycles = startup if it == 0 else iters
        p_feed_I, p_feed_D = (pavg_I_prev + pavg_D_prev if is_mos else pavg_I_prev), (0.0 if is_mos else pavg_D_prev)
        res = simulation_kernel_stateful_transient(t_curr, ia, ib, ic, cycles, dt, T_fund, w, V_phase_pk_pwm, Vdc, 1.0/fsw, fsw, E_mag_pk, E_ang, cfg["MOTOR_R"], cfg["MOTOR_L"], Tlk_I, Tlk_D, cfg["TC"], p_feed_I, p_feed_D, stat, cfg["TARGET_IDX"], 1, V_AXIS_SW, T_AXIS_SW, T_AXIS_COND, I_SW_MOS, TAB_EON, TAB_EOFF, I_COND_MOS, TAB_VDROP, I_SW_DIODE, TAB_ERR, I_COND_DIODE, TAB_VDIODE, F_R_IGBT, F_TAU_IGBT, F_R_DIODE, F_TAU_DIODE, is_mos_flag)
        (j_on, j_off, j_rr, j_ci, j_cd, j_in, acc_i2, acc_v2, n_samp, t_curr, ia, ib, ic, tjI_max, tjD_max, tjI_mean, tjD_mean) = res
        p_on, p_off, p_rr, p_ci, p_cd, p_in = j_on/stat_dur, j_off/stat_dur, j_rr/stat_dur, j_ci/stat_dur, j_cd/stat_dur, j_in/stat_dur
        pavg_I_prev, pavg_D_prev = (p_on + p_off + p_ci), (p_rr + p_cd)
        new_Tlk_I = (cfg["TC"] + (pavg_I_prev + pavg_D_prev if is_mos else pavg_I_prev) * cfg["RTH_IGBT"] if steady_mode else tjI_mean)
        new_Tlk_D = (new_Tlk_I if is_mos else (cfg["TC"] + pavg_D_prev * cfg["RTH_DIODE"])) if steady_mode else tjD_mean
        diff = max(abs(new_Tlk_I - Tlk_I), abs(new_Tlk_D - Tlk_D)); Tlk_I, Tlk_D = new_Tlk_I, new_Tlk_D
        sim_irms = math.sqrt(acc_i2/(3.0*n_samp)) if n_samp>0 else 0.0
        sim_vrms = math.sqrt(acc_v2/(3.0*n_samp)) if n_samp>0 else 0.0
        # ✅ 核心精度修复：稳态模式下返回理论稳态温度给二分法
        if steady_mode: final = (p_on, p_off, p_rr, p_ci, p_cd, p_in, sim_irms, sim_vrms, tjI_max, tjD_max, new_Tlk_I, new_Tlk_D)
        else: final = (p_on, p_off, p_rr, p_ci, p_cd, p_in, sim_irms, sim_vrms, tjI_max, tjD_max, tjI_mean, tjD_mean)
        if diff < 0.05: break
    
    # Pack Rth info
    rth_info = {"Rth_I": cfg.get("RTH_IGBT", 0.0), "Rth_D": cfg.get("RTH_DIODE", 0.0)}
    return final, {"Tlk_I": Tlk_I, "Tlk_D": Tlk_D, "pavg_I": pavg_I_prev, "pavg_D": pavg_D_prev, "Rth": rth_info}


