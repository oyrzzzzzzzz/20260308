def _strip_ns(root):
    for elem in root.iter():
        if "}" in elem.tag:
            elem.tag = elem.tag.split("}", 1)[1]

def _txt_to_arr(text):
    if not text or not text.strip():
        return np.array([], dtype=np.float64)
    return np.array([float(x) for x in text.split()], dtype=np.float64)

def _align_3d_voltage(table_3d, v_axis_src, v_axis_tgt):
    if table_3d is None or getattr(table_3d, "ndim", 0) != 3:
        return table_3d
    vs = np.array(v_axis_src if v_axis_src is not None else [], dtype=np.float64)
    vt = np.array(v_axis_tgt if v_axis_tgt is not None else [], dtype=np.float64)
    if vt.size == 0: return table_3d
    if vs.size == 0: vs = vt.copy()
    vs = np.abs(vs); vt = np.abs(vt)
    vs.sort(); vt.sort()
    Tn, Vn_src, In = table_3d.shape
    Vn_tgt = vt.size
    if Vn_src == Vn_tgt: return table_3d
    if Vn_src == 1: return np.repeat(table_3d, Vn_tgt, axis=1)
    if Vn_tgt == 1:
        idx = int(np.argmin(np.abs(vs - vt[0])))
        return table_3d[:, idx:idx+1, :]
    out = np.zeros((Tn, Vn_tgt, In), dtype=np.float64)
    for ti in range(Tn):
        for ii in range(In):
            out[ti, :, ii] = np.interp(vt, vs, table_3d[ti, :, ii], left=table_3d[ti, 0, ii], right=table_3d[ti, -1, ii])
    return out

def _build_diode_from_mos_linear_extrap_first2(i_axis_pos, v_drop_table):
    i_axis_pos = np.array(i_axis_pos, dtype=np.float64)
    v_drop_table = np.array(v_drop_table, dtype=np.float64)
    if i_axis_pos.size < 2 or v_drop_table.ndim != 2 or v_drop_table.shape[1] != i_axis_pos.size:
        return None, None
    I1, I2 = float(i_axis_pos[0]), float(i_axis_pos[1])
    if abs(I2 - I1) < 1e-12: return None, None
    diode_i = i_axis_pos.copy()
    Nt, Ni = v_drop_table.shape
    diode_v = np.zeros((Nt, Ni), dtype=np.float64)
    for ti in range(Nt):
        V1, V2 = float(v_drop_table[ti, 0]), float(v_drop_table[ti, 1])
        a = (V2 - V1) / (I2 - I1)
        b = V1 - a * I1
        Vneg = a * (-diode_i) + b
        diode_v[ti, :] = np.abs(Vneg)
    return diode_i, diode_v


