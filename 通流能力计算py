                                           f"{item['Loss']:.2f}", f"{item['P_cond']:.2f}", f"{item['P_sw']:.2f}", f"{item['Ratio']:.2f}",
                                           f"{item['P_on']:.2f}", f"{item['P_off']:.2f}", f"{item['P_rr']:.2f}"]
                            w.writerow(row)
                    elif r.get("mode") == "single":
                        rth_i = r.get("Rth_I", 0); rth_d = r.get("Rth_D", 0)
                        w.writerow(common + [f"{rth_i:.4f}", f"{rth_d:.4f}", "Single", "-", self.base_cfg["INPUT_I_RMS"], f"{r.get('Tj_mean', 0):.2f}", 
                                           f"{r.get('Loss', 0):.2f}", f"{r.get('P_cond', 0):.2f}", f"{r.get('P_sw', 0):.2f}", f"{r.get('Ratio', 0):.2f}",
                                           f"{r.get('P_on', 0):.2f}", f"{r.get('P_off', 0):.2f}", f"{r.get('P_rr', 0):.2f}"])
            messagebox.showinfo("成功", "导出成功")

