def _batch_worker_process(args):
    # This function must be at module level for pickle to work with multiprocessing
    idx, cfg, is_rating = args
    try:
        lut = _prepare_luts_from_xml(cfg)
        if is_rating:
            tasks = cfg.get("RATING_TASKS", [{"T": 150, "L": 10, "H": 300}])
            res_list, res_str = [], []
            for i, t in enumerate(tasks):
                 I_s, res, _ = solve_current_for_tj_mean(cfg, lut, float(t["L"]), float(t["H"]), float(t["T"]), 0.2, 0.1, 20)
                 p_cond = res[3] + res[4]
                 p_sw = res[0] + res[1] + res[2]
                 p_total = p_cond + p_sw
                 ratio = p_cond / p_sw if p_sw > 1e-9 else 0.0
                 res_list.append({
                     "I": I_s, "T_target": t["T"], "T_act": res[10], 
                     "Loss": p_total, "P_cond": p_cond, "P_sw": p_sw,
                     "P_on": res[0], "P_off": res[1], "P_rr": res[2], 
                     "Ratio": ratio, "Rth_I": cfg.get("RTH_IGBT", 0), "Rth_D": cfg.get("RTH_DIODE", 0)
                 })
                 res_str.append(f"{I_s:.1f}A@{t['T']}C")
            return (idx, True, " | ".join(res_str), {"mode": "rating", "data": res_list}, None)
        else:
            I_in = float(cfg["INPUT_I_RMS"]); res, _ = worker_single_point(I_in, cfg, lut, steady_mode=False)
            loss = (res[0]+res[1]+res[3]) + (res[2]+res[4])
            p_cond = res[3] + res[4]
            p_sw = res[0] + res[1] + res[2]
            ratio = p_cond / p_sw if p_sw > 1e-9 else 0.0
            final_str = f"Loss={loss:.1f}W, Tj={res[15]:.0f}C"
            res_data = {
                "mode": "single", "Loss": loss, "Tj_mean": res[15],
                "P_cond": p_cond, "P_sw": p_sw, "Ratio": ratio,
                "P_on": res[0], "P_off": res[1], "P_rr": res[2],
                "Rth_I": cfg.get("RTH_IGBT", 0), "Rth_D": cfg.get("RTH_DIODE", 0)
            }
            return (idx, True, final_str, res_data, None)
    except Exception as e:
        return (idx, False, "", {}, str(e))

