        for i in self.tree.get_children(): self.tree.delete(i)
        self.pairs = []
        files = glob.glob(os.path.join(d, "*.xml"))
        mos, igbts, diodes = [], [], []
        
        for f in files:
            try:
                data = load_data_from_xml(f); t = "Unknown"
                if data.get("IS_MOSFET"): t = "MOS"
                else:
                    is_igbt = ("IGBT_I_SW" in data or "IGBT_E_ON" in data)
                    is_diode = ("DIODE_E_RR" in data or "DIODE_I_SW" in data or "DIODE_V_DROP" in data)
                    if is_igbt: t = "IGBT"
                    elif is_diode: t = "Diode"
                if t == "MOS": mos.append(f)
                elif t == "IGBT": igbts.append(f)
                elif t == "Diode": diodes.append(f)
            except: pass
            
        for m in mos:
            nm = os.path.basename(m); self.pairs.append({"type": "MOS", "igbt": m, "diode": None, "name": nm})
            self.tree.insert("", "end", values=(nm, "MOS", nm, "-", "Ready", ""))
            
        for i_f in igbts:
            i_name = os.path.basename(i_f); i_core = os.path.splitext(i_name.lower().replace("igbt", ""))[0]
            best_d, best_score = None, 0.0
            for d_f in diodes:
                d_name = os.path.basename(d_f); d_core = os.path.splitext(d_name.lower().replace("diode", ""))[0]
                if i_core == d_core: best_d, best_score = d_f, 1.0; break
                r = difflib.SequenceMatcher(None, i_core, d_core).ratio()
                if r > best_score: best_score, best_d = r, d_f
            if best_score < 0.3: best_d = (diodes[0] if len(diodes)==1 else None)
            d_nm = (os.path.basename(best_d) if best_d else "MISSING")
            self.pairs.append({"type": "IGBT+Diode", "igbt": i_f, "diode": best_d, "name": i_name})
            self.tree.insert("", "end", values=(i_name, "IGBT+Diode", i_name, d_nm, "Ready", ""))

    def _start_run(self):
        if not self.pairs: return
        is_rating = "Rating" in self.var_mode.get()
        items = self.tree.get_children(); self.pbar["maximum"] = len(items); self.pbar["value"] = 0
        
        tasks = []
        for idx, item_id in enumerate(items):
            p = self.pairs[idx]
            if not p["igbt"] or (p["type"] == "IGBT+Diode" and not p["diode"]):
                self.tree.set(item_id, "status", "Skip"); continue
            self.tree.set(item_id, "status", "Pending...")
            
            # Create a clean config copy without Tkinter variables
            # self.base_cfg contains raw values now because we updated _start_run to use clean values, 
            # BUT we need to ensure no other Tk objects are sneaking in.
            # _cfg() method returns dict of values (int/float/str), but let's be sure.
            
            # Re-read fresh config from GUI to ensure latest values
            # (Warning: _cfg() reads from self.var_*, which are TkVars. The result is pure python types)
            # BatchDialog doesn't have _cfg(), use self.base_cfg directly but we must copy it to avoid issues
            # We already passed clean_cfg to BatchDialog, so self.base_cfg IS clean (no Tk vars).
            # But we need to make sure we don't accidentally modify the shared reference for subsequent tasks if we edit it.
            raw_cfg = self.base_cfg.copy()
            
            # Inject file paths
            raw_cfg["DIR_XML"] = os.path.dirname(p["igbt"])
            raw_cfg["FILE_XML_IGBT"] = os.path.basename(p["igbt"])
            if p["diode"]: raw_cfg["FILE_XML_DIODE"] = os.path.basename(p["diode"])
            
            tasks.append((idx, raw_cfg, is_rating))

        if not tasks: return

        # Capture pool params here to avoid pickling 'self' or GUI elements
        pool_processes = self.var_cpu.get()

        def _run_pool():
            t0 = time.time()
            self.top.after(0, lambda: self.lbl_status.configure(text=f"Running with {pool_processes} cores..."))
            try:
                # Use 'fork' context on Linux/Mac if needed, but 'spawn' is default/safe on Windows.
                # Standard Pool uses default context.
                with multiprocessing.Pool(processes=pool_processes) as pool:
                    for res in pool.imap_unordered(_batch_worker_process, tasks):
                        idx, success, res_str, res_data, err_msg = res
                        item_id = items[idx]
                        if success:
                            # We can't update self.pairs directly in the thread safely if we were strictly checking thread safety,
                            # but in Python lists/dicts are atomic enough for this assignment or we should use top.after.
                            # Better: update data in main thread callback.
                            self.top.after(0, lambda id=item_id, idx=idx, d=res_data, s=res_str: (self.pairs[idx].update({"res": d}), self.tree.set(id, "result", s), self.tree.set(id, "status", "Done")))
                        else:
                            self.top.after(0, lambda id=item_id, e=err_msg: (self.tree.set(id, "status", "Error"), self.tree.set(id, "result", e)))
                        self.top.after(0, lambda: self.pbar.step())
                dt = time.time() - t0
                self.top.after(0, lambda: (messagebox.showinfo("完成", f"批量计算结束\n耗时: {dt:.2f}s"), self.lbl_status.configure(text=f"Done in {dt:.2f}s")))
            except Exception as e:
                # Capture exception string to pass to GUI thread
                err_s = str(e)
                self.top.after(0, lambda: (messagebox.showerror("错误", f"并行池错误: {err_s}"), self.lbl_status.configure(text="Error")))

        threading.Thread(target=_run_pool, daemon=True).start()

    def _export_csv(self):
        p = filedialog.asksaveasfilename(defaultextension=".csv")
        if p:
            import csv
            with open(p, "w", newline="", encoding="utf-8-sig") as f:
                w = csv.writer(f)
                # Flat structure: One row per rating point
                base_h = ["Name", "Type", "Switch", "Diode", "Rth_IGBT", "Rth_Diode", "Mode", "Target_Tj", "Result_I_rms", "Result_Tj_Mean", "Total_Loss", "Cond_Loss", "Sw_Loss", "Ratio_Cond/Sw", "P_on", "P_off", "P_rr"]
                w.writerow(base_h)
                
                for px in self.pairs:
                    r = px.get("res", {})
                    common = [px["name"], px["type"], os.path.basename(px["igbt"]), (os.path.basename(px["diode"]) if px["diode"] else "")]
                    
                    if r.get("mode") == "rating":
                        data = r.get("data", [])
